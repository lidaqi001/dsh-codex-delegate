{
  "name": "dsh-codex-delegate",
  "version": "1.0.0",
  "type": "module",
  "description": "Codex 委托模式：一个把全部处理都交给 codex 子代理的 Agent 预设 bundle。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-bundle",
    "deepseek-harness",
    "agent-preset",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lidaqi001/dsh-codex-delegate.git"
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "icon": "./icon.svg",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent-preset": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-persona": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-subagent": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-todo": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-command-compact": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent-codex": "^0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
